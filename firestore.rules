// Firestore security rules for QuestBook.
// This file documents the rules. Paste them into Firebase console > Firestore > Rules to use them.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles. Any signed-in user can read them (group members need each other's
    // names), but only the user can create or change their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Quest photos. Only signed-in users. A new photo must belong to the user who uploads it.
    // TODO: limit reading to members of the quest's group once groups are stored in Firestore.
    match /photos/{photoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Private groups. Only members can read a group. A new group must be owned by the
    // user who creates it, and that user must be its only member.
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
    }

    // Invite codes point to a group. A signed-in user can look up a code they already
    // know (get), but nobody can list the codes. Only the group's owner can create its
    // code, together with the group, and a code can never be overwritten.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;
    }

    // TODO: add rules for quests when they are stored in Firestore.
    // Anything not listed here is denied.
  }
}
